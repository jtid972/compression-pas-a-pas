{
  "name": "Compression pas à pas",
  "short_name": "Compression",
  "description": "Allège vidéos, images, documents bureautiques et PDF, avec estimation du gain avant lancement.",
  "lang": "fr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#f6f5f2",
  "theme_color": "#1f4e79",
  "icons": [
    {"src": "/static/icons/icon-192.png", "sizes": "192x192", "type": "image/png"},
    {"src": "/static/icons/icon-512.png", "sizes": "512x512", "type": "image/png"},
    {"src": "/static/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ],
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{"name": "file", "accept": ["video/*", "image/*", "application/pdf", ".pdf", ".docx", ".pptx", ".xlsx", ".odt", ".odp", ".ods"]}]
    }
  }
}
